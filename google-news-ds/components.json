          "color": "sys.color.onSecondaryContainer"
        }
      }
    },
    "Chip": {
      "name": "Chip",
      "family": "selection",
      "description": "Filter and topic chips with 8px radius, min 48px touch target, and selectable active state.",
      "anatomy": {
