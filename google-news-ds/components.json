          "gap": "10px",
          "color": "#444746"
        },
        "icon": {
          "color": "sys.color.primary"
        }
      }
    },
    "Dialog": {
      "name": "Dialog",
      "family": "containment",
      "description": "Modal container with 28px radius, title, body content, and action button bar.",
      "anatomy": {
        "container": {
          "borderRadius": "28px",
