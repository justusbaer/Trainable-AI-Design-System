        "variant",
        "type",
        "name",
        "value",
        "disabled",
        "loading",
        "icon",
        "icon-source",
        "hide-label",
        "compact",
        "aria",
        "form"
      ],
      "a11y": {
        "minTouchTarget": "48x48px",
        "focusIndicator": "2px outline var(--p-color-focus) with 2px offset",
        "requiredAria": [
          "aria-label (when hide-label=true)"
        ]
      },
      "rules": [
        "Always use <p-button> instead of raw HTML <button>.",
        "Maintain touch targets >= 48x48px for all touch surfaces.",
        "Labels MUST use sentence case (e.g., 'Discover models', 'Save configuration').",
        "When hide-label=true, provide an explicit aria attribute."
