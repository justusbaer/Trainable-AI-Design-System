      "examples": [
        "<p-button variant=\"primary\">Discover models</p-button>",
        "<p-button variant=\"secondary\" icon=\"arrow-right\">Configure now</p-button>",
        "<p-button variant=\"secondary\" hide-label=\"true\" icon=\"play\" aria='{\"aria-label\": \"Play video\"}'></p-button>"
      ]
