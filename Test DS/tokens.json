{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.7.0",
  "name": "Porsche Design System Tokens",
  "ref": {
    "palette": {
      "primary": {
        "0": {
          "$value": "#000000",
          "$type": "color",
          "$description": "Absolute black"
        },
        "10": {
          "$value": "#010205",
          "$type": "color",
          "$description": "Porsche black tone 10 (Light primary, Dark canvas)"
        },
        "20": {
          "$value": "#0e0e12",
          "$type": "color",
          "$description": "Porsche deep charcoal / model signature"
        },
        "30": {
          "$value": "#19191a",
          "$type": "color",
          "$description": "Porsche dark surface"
        },
        "40": {
          "$value": "#242428",
          "$type": "color",
          "$description": "Contrast low (light)"
        },
        "50": {
          "$value": "#646572",
          "$type": "color",
          "$description": "Mid-tone slate"
        },
        "60": {
          "$value": "#8f91a3",
          "$type": "color",
          "$description": "Frosted tint base"
        },
        "70": {
          "$value": "#b2b2b8",
          "$type": "color",
          "$description": "Contrast lower (dark)"
        },
        "80": {
          "$value": "#dededf",
          "$type": "color",
          "$description": "Light surface container"
        },
        "90": {
          "$value": "#f1f1f4",
          "$type": "color",
          "$description": "Light surface"
        },
        "95": {
          "$value": "#f6f6f8",
          "$type": "color",
          "$description": "Dark contrast high base"
        },
        "98": {
          "$value": "#fafbff",
          "$type": "color",
          "$description": "Dark primary text"
        },
        "100": {
          "$value": "#ffffff",
          "$type": "color",
          "$description": "Absolute pure white"
        }
      },
      "feedback": {
        "info": {
          "light": {
            "$value": "#1a44ea",
            "$type": "color"
          },
          "dark": {
            "$value": "#178bff",
            "$type": "color"
          }
        },
        "success": {
          "light": {
            "$value": "#197e10",
            "$type": "color"
          },
          "dark": {
            "$value": "#10c47f",
            "$type": "color"
          }
        },
        "warning": {
          "light": {
            "$value": "#ac5102",
            "$type": "color"
          },
          "dark": {
            "$value": "#f4882a",
            "$type": "color"
          }
        },
        "error": {
          "light": {
            "$value": "#ba171f",
            "$type": "color"
          },
          "dark": {
            "$value": "#fc4040",
            "$type": "color"
          }
        }
      }
    }
  },
  "sys": {
    "color": {
      "light": {
        "canvas": {
          "$value": "#ffffff",
          "$type": "color",
          "$description": "Light page background canvas"
        },
        "surface": {
          "$value": "#f1f1f4",
          "$type": "color",
          "$description": "Light primary surface container"
        },
        "primary": {
          "$value": "#010205",
          "$type": "color",
          "$description": "High-emphasis primary brand fill/text"
        },
        "onPrimary": {
          "$value": "#ffffff",
          "$type": "color",
          "$description": "Text and icon on primary fill"
        },
        "frosted": {
          "$value": "hsla(240, 5%, 70%, 0.148)",
          "$type": "color",
          "$description": "Standard frosted overlay"
        },
        "frostedSoft": {
          "$value": "rgba(143, 145, 163, 0.06)",
          "$type": "color",
          "$description": "Subtle frosted background"
        },
        "frostedStrong": {
          "$value": "rgba(100, 101, 114, 0.236)",
          "$type": "color",
          "$description": "Elevated frosted button/card fill"
        },
        "contrastHigher": {
          "$value": "rgba(21, 21, 25, 0.8)",
          "$type": "color",
          "$description": "Primary high-emphasis typography"
        },
        "contrastHigh": {
          "$value": "rgba(26, 26, 30, 0.7)",
          "$type": "color",
          "$description": "Body and heading text"
        },
        "contrastMedium": {
          "$value": "rgba(17, 17, 19, 0.6)",
          "$type": "color",
          "$description": "Secondary copy and labels"
        },
        "contrastLow": {
          "$value": "rgba(36, 36, 40, 0.5)",
          "$type": "color",
          "$description": "De-emphasized captions and placeholders"
        },
        "contrastLower": {
          "$value": "rgba(79, 80, 89, 0.324)",
          "$type": "color",
          "$description": "Borders, dividers, and disabled states"
        },
        "info": {
          "$value": "#1a44ea",
          "$type": "color",
          "$description": "Informational badges and alerts"
        },
        "success": {
          "$value": "#197e10",
          "$type": "color",
          "$description": "Success confirmations and checkmarks"
        },
        "warning": {
          "$value": "#ac5102",
          "$type": "color",
          "$description": "Warnings and cautions"
        },
        "error": {
          "$value": "#ba171f",
          "$type": "color",
          "$description": "Destructive actions and validation errors"
        },
        "focus": {
          "$value": "#1a44ea",
          "$type": "color",
          "$description": "Accessible focus ring"
        },
        "backdrop": {
          "$value": "rgba(36, 36, 40, 0.5)",
          "$type": "color",
          "$description": "Modal and flyout scrim backdrop"
        }
      },
      "dark": {
        "canvas": {
          "$value": "#010205",
          "$type": "color",
          "$description": "Dark page background canvas"
        },
        "surface": {
          "$value": "#19191a",
          "$type": "color",
          "$description": "Dark primary surface container"
        },
        "primary": {
          "$value": "#fafbff",
          "$type": "color",
          "$description": "High-emphasis primary brand fill/text in dark mode"
        },
        "onPrimary": {
          "$value": "#010205",
          "$type": "color",
          "$description": "Text and icon on primary fill in dark mode"
        },
        "frosted": {
          "$value": "hsla(240, 2%, 43%, 0.228)",
          "$type": "color",
          "$description": "Dark standard frosted overlay"
        },
        "frostedSoft": {
          "$value": "rgba(65, 65, 70, 0.154)",
          "$type": "color",
          "$description": "Dark subtle frosted background"
        },
        "frostedStrong": {
          "$value": "rgba(156, 156, 159, 0.3)",
          "$type": "color",
          "$description": "Dark elevated frosted button/card fill"
        },
        "contrastHigher": {
          "$value": "rgba(246, 246, 248, 0.78)",
          "$type": "color",
          "$description": "Dark primary high-emphasis typography"
        },
        "contrastHigh": {
          "$value": "rgba(246, 246, 248, 0.67)",
          "$type": "color",
          "$description": "Dark body and heading text"
        },
        "contrastMedium": {
          "$value": "rgba(246, 246, 248, 0.56)",
          "$type": "color",
          "$description": "Dark secondary copy and labels"
        },
        "contrastLow": {
          "$value": "rgba(246, 246, 248, 0.45)",
          "$type": "color",
          "$description": "Dark de-emphasized captions"
        },
        "contrastLower": {
          "$value": "rgba(156, 156, 159, 0.302)",
          "$type": "color",
          "$description": "Dark borders, dividers, disabled states"
        },
        "info": {
          "$value": "#178bff",
          "$type": "color",
          "$description": "Dark informational badges"
        },
        "success": {
          "$value": "#10c47f",
          "$type": "color",
          "$description": "Dark success status"
        },
        "warning": {
          "$value": "#f4882a",
          "$type": "color",
          "$description": "Dark warning indicators"
        },
        "error": {
          "$value": "#fc4040",
          "$type": "color",
          "$description": "Dark destructive actions and validation errors"
        },
        "focus": {
          "$value": "#1a44ea",
          "$type": "color",
          "$description": "Accessible focus ring"
        },
        "backdrop": {
          "$value": "rgba(36, 36, 40, 0.5)",
          "$type": "color",
          "$description": "Dark modal scrim backdrop"
        }
      }
    },
    "typescale": {
      "fontFamily": {
        "porscheNext": {
          "$value": "\"Porsche Next\", \"Arial Narrow\", Arial, \"Heiti SC\", SimHei, sans-serif",
          "$type": "fontFamily"
        }
      },
      "fontWeight": {
        "normal": {
          "$value": "400",
          "$type": "fontWeight"
        },
        "semibold": {
          "$value": "600",
          "$type": "fontWeight"
        },
        "bold": {
          "$value": "700",
          "$type": "fontWeight"
        }
      },
      "lineHeight": {
        "normal": {
          "$value": "calc(6px + 2.125ex)",
          "$type": "lineHeight"
        }
      },
      "tiers": {
        "2xs": {
          "$value": "0.75rem",
          "$type": "dimension",
          "$description": "Micro disclaimer, legal text (12px)"
        },
        "xs": {
          "$value": "0.875rem",
          "$type": "dimension",
          "$description": "Captions, small badges, timestamps (14px)"
        },
        "sm": {
          "$value": "1rem",
          "$type": "dimension",
          "$description": "Standard body text, base UI controls (16px)"
        },
        "md": {
          "$value": "clamp(1.13rem, 0.21vw + 1.08rem, 1.33rem)",
          "$type": "dimension",
          "$description": "Subheadings, large copy"
        },
        "lg": {
          "$value": "clamp(1.27rem, 0.51vw + 1.16rem, 1.78rem)",
          "$type": "dimension",
          "$description": "Section subheaders"
        },
        "xl": {
          "$value": "clamp(1.42rem, 0.94vw + 1.23rem, 2.37rem)",
          "$type": "dimension",
          "$description": "Section headings"
        },
        "2xl": {
          "$value": "clamp(1.6rem, 1.56vw + 1.29rem, 3.16rem)",
          "$type": "dimension",
          "$description": "Major section title"
        },
        "3xl": {
          "$value": "clamp(1.8rem, 2.41vw + 1.32rem, 4.21rem)",
          "$type": "dimension",
          "$description": "Page headline"
        },
        "4xl": {
          "$value": "clamp(2.03rem, 3.58vw + 1.31rem, 5.61rem)",
          "$type": "dimension",
          "$description": "Hero display title"
        },
        "5xl": {
          "$value": "clamp(2.28rem, 5.2vw + 1.24rem, 7.48rem)",
          "$type": "dimension",
          "$description": "Massive stage splash title"
        }
      }
    },
    "spacing": {
      "static": {
        "2xs": {
          "$value": "1px",
          "$type": "dimension"
        },
        "xs": {
          "$value": "4px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "8px",
          "$type": "dimension"
        },
        "md": {
          "$value": "16px",
          "$type": "dimension"
        },
        "lg": {
          "$value": "32px",
          "$type": "dimension"
        },
        "xl": {
          "$value": "48px",
          "$type": "dimension"
        },
        "2xl": {
          "$value": "80px",
          "$type": "dimension"
        }
      },
      "fluid": {
        "xs": {
          "$value": "clamp(4px, 0.25vw + 3px, 8px)",
          "$type": "dimension"
        },
        "sm": {
          "$value": "clamp(8px, 0.5vw + 6px, 16px)",
          "$type": "dimension"
        },
        "md": {
          "$value": "clamp(16px, 1.25vw + 12px, 36px)",
          "$type": "dimension"
        },
        "lg": {
          "$value": "clamp(32px, 2.75vw + 23px, 76px)",
          "$type": "dimension"
        },
        "xl": {
          "$value": "clamp(48px, 3vw + 38px, 96px)",
          "$type": "dimension"
        },
        "2xl": {
          "$value": "clamp(80px, 7.5vw + 56px, 200px)",
          "$type": "dimension"
        }
      }
    },
    "radius": {
      "xs": {
        "$value": "2px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "4px",
        "$type": "dimension"
      },
      "md": {
        "$value": "6px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "8px",
        "$type": "dimension"
      },
      "xl": {
        "$value": "12px",
        "$type": "dimension",
        "$description": "Standard Porsche button and card corner radius"
      },
      "2xl": {
        "$value": "16px",
        "$type": "dimension"
      },
      "3xl": {
        "$value": "24px",
        "$type": "dimension"
      },
      "4xl": {
        "$value": "32px",
        "$type": "dimension"
      },
      "full": {
        "$value": "9999px",
        "$type": "dimension",
        "$description": "Pill / circular radius"
      }
    },
    "elevation": {
      "shadowSm": {
        "$value": "0px 3px 8px rgba(0, 0, 0, 0.16)",
        "$type": "shadow"
      },
      "shadowMd": {
        "$value": "0px 4px 16px rgba(0, 0, 0, 0.16)",
        "$type": "shadow"
      },
      "shadowLg": {
        "$value": "0px 8px 40px rgba(0, 0, 0, 0.16)",
        "$type": "shadow"
      },
      "blurFrosted": {
        "$value": "blur(32px)",
        "$type": "filter",
        "$description": "Porsche frosted glass backdrop blur"
      }
    },
    "motion": {
      "duration": {
        "sm": {
          "$value": "0.25s",
          "$type": "duration",
          "$description": "Short micro-interactions, hover"
        },
        "md": {
          "$value": "0.4s",
          "$type": "duration",
          "$description": "Standard element transitions, dropdowns"
        },
        "lg": {
          "$value": "0.6s",
          "$type": "duration",
          "$description": "Drawer, modal enter/exit"
        },
        "xl": {
          "$value": "1.2s",
          "$type": "duration",
          "$description": "Stage hero animations"
        }
      },
      "easing": {
        "base": {
          "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)",
          "$type": "cubicBezier",
          "$description": "Porsche standard ease-in-out"
        },
        "in": {
          "$value": "cubic-bezier(0, 0, 0.2, 1)",
          "$type": "cubicBezier"
        },
        "out": {
          "$value": "cubic-bezier(0.4, 0, 0.5, 1)",
          "$type": "cubicBezier"
        }
      }
    }
  }
}