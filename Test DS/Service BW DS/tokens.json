{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Serviceportal Baden-Württemberg Design Tokens",
  "version": "1.7.0",
  "sourceOfTruth": "https://www.service-bw.de",
  "ref": {
    "palette": {
      "highlight": {
        "100": { "$value": "#ffffff", "$type": "color" },
        "95": { "$value": "#fffae0", "$type": "color" },
        "90": { "$value": "#fff6b8", "$type": "color" },
        "80": { "$value": "#fffc00", "$type": "color", "$description": "Official Baden-Württemberg State Yellow / Gold" },
        "70": { "$value": "#e6e300", "$type": "color" },
        "60": { "$value": "#cccc00", "$type": "color" },
        "50": { "$value": "#999900", "$type": "color" },
        "40": { "$value": "#666600", "$type": "color" },
        "30": { "$value": "#444400", "$type": "color" },
        "20": { "$value": "#2b2b00", "$type": "color" },
        "10": { "$value": "#151500", "$type": "color" },
        "0": { "$value": "#000000", "$type": "color" }
      },
      "neutral": {
        "100": { "$value": "#ffffff", "$type": "color", "$description": "Pure white canvas" },
        "98": { "$value": "#faf9f8", "$type": "color" },
        "95": { "$value": "#f4f3f1", "$type": "color", "$description": "Content background / card container" },
        "90": { "$value": "#e8e6e2", "$type": "color" },
        "85": { "$value": "#dedbd5", "$type": "color" },
        "75": { "$value": "#cbc6bd", "$type": "color", "$description": "Structural 1px border" },
        "50": { "$value": "#7a756e", "$type": "color" },
        "30": { "$value": "#47535c", "$type": "color", "$description": "Secondary contrast text" },
        "15": { "$value": "#2a2623", "$type": "color", "$description": "Primary text charcoal rgb(42,38,35)" },
        "10": { "$value": "#1a1816", "$type": "color" },
        "0": { "$value": "#000000", "$type": "color", "$description": "Absolute contrast black" }
      },
      "action": {
        "primary": { "$value": "#116a8d", "$type": "color", "$description": "BW Administrative CTA Blue" },
        "hover": { "$value": "#0d536e", "$type": "color" },
        "container": { "$value": "#e0edf4", "$type": "color" }
      },
      "feedback": {
        "success": { "$value": "#00753a", "$type": "color", "$description": "Official Success Green" },
        "error": { "$value": "#bb232b", "$type": "color", "$description": "Official Error Crimson" },
        "warning": { "$value": "#165571", "$type": "color", "$description": "Official Warning Blue-Slate" },
        "banner": { "$value": "#af0060", "$type": "color", "$description": "Official Announcement Magenta" }
      }
    }
  },
  "sys": {
    "color": {
      "light": {
        "primary": { "$value": "#fffc00", "$type": "color", "$description": "Primary Brand Highlight (State Yellow)" },
        "onPrimary": { "$value": "#2a2623", "$type": "color", "$description": "High contrast charcoal text on yellow" },
        "primaryContainer": { "$value": "#fffc00", "$type": "color" },
        "onPrimaryContainer": { "$value": "#2a2623", "$type": "color" },
        "secondary": { "$value": "#116a8d", "$type": "color", "$description": "Call-to-action Administrative Blue" },
        "onSecondary": { "$value": "#ffffff", "$type": "color" },
        "secondaryContainer": { "$value": "#e0edf4", "$type": "color" },
        "onSecondaryContainer": { "$value": "#0b435a", "$type": "color" },
        "tertiary": { "$value": "#47535c", "$type": "color", "$description": "Slate accent for subtle indicators" },
        "onTertiary": { "$value": "#ffffff", "$type": "color" },
        "surface": { "$value": "#ffffff", "$type": "color", "$description": "Base canvas background" },
        "onSurface": { "$value": "#2a2623", "$type": "color", "$description": "Primary body copy" },
        "surfaceVariant": { "$value": "#f4f3f1", "$type": "color", "$description": "Card and panel container" },
        "onSurfaceVariant": { "$value": "#47535c", "$type": "color" },
        "surfaceContainerLowest": { "$value": "#ffffff", "$type": "color" },
        "surfaceContainerLow": { "$value": "#faf9f8", "$type": "color" },
        "surfaceContainer": { "$value": "#f4f3f1", "$type": "color" },
        "surfaceContainerHigh": { "$value": "#e8e6e2", "$type": "color" },
        "surfaceContainerHighest": { "$value": "#dedbd5", "$type": "color" },
        "outline": { "$value": "#2a2623", "$type": "color", "$description": "3:1 accessible interactive border" },
        "outlineVariant": { "$value": "#cbc6bd", "$type": "color", "$description": "Subtle card & divider border" },
        "error": { "$value": "#bb232b", "$type": "color" },
        "onError": { "$value": "#ffffff", "$type": "color" },
        "errorContainer": { "$value": "#ffdad6", "$type": "color" },
        "onErrorContainer": { "$value": "#410002", "$type": "color" },
        "success": { "$value": "#00753a", "$type": "color" },
        "onSuccess": { "$value": "#ffffff", "$type": "color" },
        "warning": { "$value": "#165571", "$type": "color" },
        "onWarning": { "$value": "#ffffff", "$type": "color" },
        "header": { "$value": "#fffc00", "$type": "color" },
        "onHeader": { "$value": "#2a2623", "$type": "color" },
        "footer": { "$value": "#2a2623", "$type": "color" },
        "onFooter": { "$value": "#ffffff", "$type": "color" },
        "disabled": { "$value": "#eeeeee", "$type": "color" },
        "onDisabled": { "$value": "#7a756e", "$type": "color" }
      },
      "dark": {
        "primary": { "$value": "#fffc00", "$type": "color" },
        "onPrimary": { "$value": "#000000", "$type": "color" },
        "primaryContainer": { "$value": "#333200", "$type": "color" },
        "onPrimaryContainer": { "$value": "#fffc00", "$type": "color" },
        "secondary": { "$value": "#5dc3eb", "$type": "color" },
        "onSecondary": { "$value": "#003548", "$type": "color" },
        "surface": { "$value": "#1a1816", "$type": "color" },
        "onSurface": { "$value": "#f4f3f1", "$type": "color" },
        "surfaceVariant": { "$value": "#2a2623", "$type": "color" },
        "onSurfaceVariant": { "$value": "#cbc6bd", "$type": "color" },
        "surfaceContainer": { "$value": "#24201e", "$type": "color" },
        "surfaceContainerHigh": { "$value": "#2f2b28", "$type": "color" },
        "outline": { "$value": "#cbc6bd", "$type": "color" },
        "outlineVariant": { "$value": "#47535c", "$type": "color" },
        "footer": { "$value": "#121110", "$type": "color" },
        "onFooter": { "$value": "#ffffff", "$type": "color" }
      }
    },
    "typescale": {
      "fontFamilySans": { "$value": "\"BaWueSans\", Arial, sans-serif", "$type": "fontFamily" },
      "fontFamilySerif": { "$value": "\"BaWueSerif\", Arial, serif", "$type": "fontFamily" },
      "displayLarge": {
        "fontFamily": "{sys.typescale.fontFamilySerif}",
        "fontSize": "36px",
        "lineHeight": "43.2px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "displayMedium": {
        "fontFamily": "{sys.typescale.fontFamilySerif}",
        "fontSize": "32px",
        "lineHeight": "38.4px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "headlineLarge": {
        "fontFamily": "{sys.typescale.fontFamilySerif}",
        "fontSize": "36px",
        "lineHeight": "43.2px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "headlineMedium": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "30px",
        "lineHeight": "36px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "headlineSmall": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "26px",
        "lineHeight": "31.2px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "titleLarge": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "titleMedium": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 700,
        "letterSpacing": "0px"
      },
      "titleSmall": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 700,
        "letterSpacing": "0.1px"
      },
      "bodyLarge": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "18px",
        "lineHeight": "27px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "bodyMedium": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "bodySmall": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "labelLarge": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 700,
        "letterSpacing": "0.1px"
      },
      "labelMedium": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 700,
        "letterSpacing": "0.5px"
      },
      "labelSmall": {
        "fontFamily": "{sys.typescale.fontFamilySans}",
        "fontSize": "11px",
        "lineHeight": "14px",
        "fontWeight": 700,
        "letterSpacing": "0.5px"
      }
    },
    "shape": {
      "borderRadius": { "$value": "3px", "$type": "dimension" },
      "borderRadiusPill": { "$value": "9999px", "$type": "dimension" },
      "borderRadiusFab": { "$value": "50%", "$type": "dimension" }
    },
    "state": {
      "hover": { "$value": 0.08, "$type": "number" },
      "focus": {
        "ring": { "$value": "3px solid #fffc00", "$type": "string" },
        "offset": { "$value": "2px", "$type": "dimension" },
        "outline": { "$value": "2px solid #2a2623", "$type": "string" }
      },
      "pressed": { "$value": 0.10, "$type": "number" },
      "disabled": {
        "opacity": { "$value": 0.38, "$type": "number" },
        "container": { "$value": "#eeeeee", "$type": "color" }
      }
    },
    "elevation": {
      "level0": { "shadow": "none" },
      "level1": { "shadow": "0 1px 3px rgba(42,38,35,0.08)" },
      "level2": { "shadow": "0 4px 12px rgba(42,38,35,0.12)" },
      "level3": { "shadow": "0 8px 24px rgba(42,38,35,0.16)" }
    }
  }
}
