rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Design Systems collection
    match /design_systems/{dsId} {
      // Allow read for any authenticated user or verified agent API key
      allow read: if request.auth != null;

      // Allow write only for users with owner/editor role
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'editor');

      // Nested subcollections: tokens, components, rules
      match /{allSubcollections=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && 
          (request.auth.token.role == 'admin' || request.auth.token.role == 'editor');
      }
    }
  }
}
